  {
    "start": 678.72,
    "end": 682.32,
    "text": "like Boys And Girls"
  },
  {
    "start": 680.92,
    "end": 684.959,
    "text": "주은 건"
  },
  {
    "start": 682.32,
    "end": 687.6,
    "text": "아니고요네 체크인이 체크아웃도 다"
