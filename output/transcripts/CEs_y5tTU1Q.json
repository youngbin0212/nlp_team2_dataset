[
  {
    "start": 1.309,
    "end": 3.3289999999999997,
    "text": "[음악]"
  },
  {
    "start": 8.599,
    "end": 12.679,
    "text": "있긴 해요."
  },
  {
    "start": 10.36,
    "end": 14.879,
    "text": "또 캐년 선수가"
  },
  {
    "start": 12.679,
    "end": 17.8,
    "text": "굉장히 좀 아 단단하면서 임팩트 있는"
  },
  {
    "start": 14.879,
    "end": 20.64,
    "text": "픽들을 좀 선발을 했었는데 일단"
  },
  {
    "start": 17.8,
    "end": 24.039,
    "text": "럼블에 대한 관심은 충분히 더"
  },
  {
    "start": 20.64,
    "end": 25.8,
    "text": "큽니다. 이렇게 완성이 됐고음 오늘"
  },
  {
    "start": 24.039,
    "end": 27.8,
    "text": "뭐 자주 나오네요, 얘기."
  },
  {
    "start": 25.8,
    "end": 30.8,
    "text": ">> 음."
  },
  {
    "start": 27.8,
    "end": 32.160000000000004,
    "text": "그리고 초상화가 약간 살벌한 친구들이"
  },
  {
    "start": 30.8,
    "end": 34.879,
    "text": "올라오고 있긴 한데"
  },
  {
    "start": 32.16,
    "end": 35.63999999999999,
    "text": ">> 예"
  },
  {
    "start": 34.879,
    "end": 37.599999999999994,
    "text": ">> 오"
  },
  {
    "start": 35.64,
    "end": 41.480000000000004,
    "text": ">> 네백톤이 나오네요."
  },
  {
    "start": 37.6,
    "end": 42.800000000000004,
    "text": ">> 그래서 라인을 그러면"
  },
  {
    "start": 41.48,
    "end": 45.0,
    "text": ">> 상"
  },
  {
    "start": 42.8,
    "end": 46.959999999999994,
    "text": ">> 무조건에 뺏기기 싫다란 의도로 이런"
  },
  {
    "start": 45.0,
    "end": 48.96,
    "text": "뱀픽을 한 거 같은데네"
  },
  {
    "start": 46.96,
    "end": 50.559,
    "text": ">> 끝났습니다. 첫 번째 세타 지금부터"
  },
  {
    "start": 48.96,
    "end": 52.239000000000004,
    "text": "만나보시죠.이 이 공에 대해서도"
  },
  {
    "start": 50.559,
    "end": 52.839999999999996,
    "text": "어떻게 T1도 생각을 했을지도"
  },
  {
    "start": 52.239,
    "end": 55.038999999999994,
    "text": "궁금합니다."
  },
  {
    "start": 52.84,
    "end": 57.800000000000004,
    "text": ">> 그때 럼블 구도 같은게 나왔을 때 어"
  },
  {
    "start": 55.039,
    "end": 60.68,
    "text": "여기 승률이 아주"
  },
  {
    "start": 57.8,
    "end": 62.239,
    "text": ">> 준비하고 있습니다."
  },
  {
    "start": 60.68,
    "end": 62.96,
    "text": ">> 진짜 예전에 어 순간 이동을"
  },
  {
    "start": 62.239,
    "end": 65.36,
    "text": "알려탔어요."
  },
  {
    "start": 62.96,
    "end": 67.119,
    "text": ">> 그렇습니다. 일단 1792일 만에"
  },
  {
    "start": 65.36,
    "end": 68.2,
    "text": "등장한 상황에서 바가 덤역을 좀더"
  },
  {
    "start": 67.119,
    "end": 69.4,
    "text": "때려보고 있습니다."
  },
  {
    "start": 68.2,
    "end": 71.08,
    "text": ">> 슬로우가 묻은 상태로"
  },
  {
    "start": 69.4,
    "end": 71.56,
    "text": ">> 캐리아가 쫓아가고요. 위에는 위대로"
  },
  {
    "start": 71.08,
    "end": 73.39999999999999,
    "text": "붙습니다."
  },
  {
    "start": 71.56,
    "end": 74.119,
    "text": ">> 어 그래서 계속 때리면 드로도"
  },
  {
    "start": 73.4,
    "end": 75.68,
    "text": "위험하고"
  },
  {
    "start": 74.119,
    "end": 76.4,
    "text": ">> 카스퍼블도 만들어 놓고 위쪽으로"
  },
  {
    "start": 75.68,
    "end": 78.36000000000001,
    "text": "쫓아가 봅니다."
  },
  {
    "start": 76.4,
    "end": 79.159,
    "text": ">> 오너도 살짝 위험한데요."
  },
  {
    "start": 78.36,
    "end": 81.4,
    "text": "잡혔고요."
  },
  {
    "start": 79.159,
    "end": 83.759,
    "text": ">> 그래서 페이즈가 와서 좀 때려주고"
  },
  {
    "start": 81.4,
    "end": 84.68,
    "text": "근데 역으로 올라왔죠. 와 순간적으로"
  },
  {
    "start": 83.759,
    "end": 85.759,
    "text": ">> 이렇게 캐년이"
  },
  {
    "start": 84.68,
    "end": 86.72000000000001,
    "text": ">> 근데 서로 또 교환"
  },
  {
    "start": 85.759,
    "end": 88.479,
    "text": ">> 다시 한번 교환입니다."
  },
  {
    "start": 86.72,
    "end": 89.64,
    "text": ">> 그리고 쌍버프 룰루가"
  },
  {
    "start": 88.479,
    "end": 90.72,
    "text": ">> 룰루의 쌍버프가"
  },
  {
    "start": 89.64,
    "end": 91.799,
    "text": ">> 쌍버프 내놔"
  },
  {
    "start": 90.72,
    "end": 92.6,
    "text": ">> 쌍버프가"
  },
  {
    "start": 91.799,
    "end": 94.119,
    "text": ">> 쌍버프"
  },
  {
    "start": 92.6,
    "end": 95.96,
    "text": ">> 쌍버프가 이렇게 넘어갔고요."
  },
  {
    "start": 94.119,
    "end": 97.159,
    "text": ">> 용쪽 신경전을 하려면 할 순 있었는데"
  },
  {
    "start": 95.96,
    "end": 99.36,
    "text": "좀 힘들었거든요."
  },
  {
    "start": 97.159,
    "end": 99.96000000000001,
    "text": ">> 어 그래서 이거 탑에 한번 풀자"
  },
  {
    "start": 99.36,
    "end": 101.0,
    "text": "돌려습니다."
  },
  {
    "start": 99.96,
    "end": 102.079,
    "text": ">> 강신이 없는 턴에"
  },
  {
    "start": 101.0,
    "end": 106.6,
    "text": ">> 자 골카를 꽂았고 딜틀"
  },
  {
    "start": 102.079,
    "end": 106.6,
    "text": ">> 아데 트페도 마화가 없고요. 예딜"
  },
  {
    "start": 106.759,
    "end": 109.759,
    "text": "깔리고요. 예."
  },
  {
    "start": 108.24,
    "end": 111.15899999999999,
    "text": ">> 그니까 레넥톤는 한 번에 잡을"
  },
  {
    "start": 109.759,
    "end": 112.079,
    "text": "생각이었던 거 같습니다. 좀"
  },
  {
    "start": 111.159,
    "end": 113.36,
    "text": "애매했고."
  },
  {
    "start": 112.079,
    "end": 114.32,
    "text": ">> 자, 일단 돌란는 위쪽으로"
  },
  {
    "start": 113.36,
    "end": 116.439,
    "text": "빠져나가면서 일단 길은"
  },
  {
    "start": 114.32,
    "end": 120.03899999999999,
    "text": "틀어막았습니다만 4대 2가 됩니다."
  },
  {
    "start": 116.439,
    "end": 120.03899999999999,
    "text": "스카너 붙어 있고요."
  },
  {
    "start": 120.2,
    "end": 122.71900000000001,
    "text": "예. 일단 럼블이 이퀄라이저는"
  },
  {
    "start": 122.159,
    "end": 123.759,
    "text": "없어요."
  },
  {
    "start": 122.719,
    "end": 125.119,
    "text": ">> 네. 그러니까"
  },
  {
    "start": 123.759,
    "end": 126.36,
    "text": ">> 골카만 찍고 와찰"
  },
  {
    "start": 125.119,
    "end": 127.52,
    "text": ">> 심지어 연계까지 되면"
  },
  {
    "start": 126.36,
    "end": 128.92,
    "text": ">> 더 찌릅니다. 더 찌릅니다. 더"
  },
  {
    "start": 127.52,
    "end": 130.599,
    "text": "찌릅니다. 일단 초비 뒤로"
  },
  {
    "start": 128.92,
    "end": 133.04,
    "text": ">> 스카너가 어떻게든 커버해 주려고"
  },
  {
    "start": 130.599,
    "end": 134.2,
    "text": "하는데 뚫기로 끌고 갑니다. 쪽으로"
  },
  {
    "start": 133.04,
    "end": 136.239,
    "text": ">> 그래서"
  },
  {
    "start": 134.2,
    "end": 137.56,
    "text": ">> 그 다이브 갔구나요?"
  },
  {
    "start": 136.239,
    "end": 138.28,
    "text": ">> 다점 다 왔거든요."
  },
  {
    "start": 137.56,
    "end": 139.8,
    "text": ">> 다 왔어요."
  },
  {
    "start": 138.28,
    "end": 141.481,
    "text": ">> 예 무조건 풀어야 된다."
  },
  {
    "start": 139.8,
    "end": 142.87900000000002,
    "text": ">> 그다"
  },
  {
    "start": 141.481,
    "end": 144.64,
    "text": "[비명]"
  },
  {
    "start": 142.879,
    "end": 146.28,
    "text": ">> 만했죠.이 이 가운데 다이브를 해"
  },
  {
    "start": 144.64,
    "end": 148.92,
    "text": "가지고"
  },
  {
    "start": 146.28,
    "end": 150.16,
    "text": "자. 연타를 날리면 얘기가 달라요."
  },
  {
    "start": 148.92,
    "end": 151.76,
    "text": ">> 어, 내려왔네요. 브레이커가"
  },
  {
    "start": 150.16,
    "end": 154.239,
    "text": ">> 세라핀 아직 5레벨이에요. 그래서"
  },
  {
    "start": 151.76,
    "end": 157.04,
    "text": "따이브를 바로 일단 세라핀부터"
  },
  {
    "start": 154.239,
    "end": 158.28,
    "text": ">> 일단 잡았고 럼블이 근데 내려오고"
  },
  {
    "start": 157.04,
    "end": 160.12,
    "text": "있다는 거 그리고 이퀄라이저"
  },
  {
    "start": 158.28,
    "end": 162.28,
    "text": "있거든요. 그래서 빠질 때 좀 잘"
  },
  {
    "start": 160.12,
    "end": 165.061,
    "text": "빠져야 돼요. 아니면 잡고 나가려고"
  },
  {
    "start": 162.28,
    "end": 165.519,
    "text": ">> 그래서 정면 들어왔는데 눌러가면이"
  },
  {
    "start": 165.061,
    "end": 166.4,
    "text": "[비명]"
  },
  {
    "start": 165.519,
    "end": 168.4,
    "text": ">> 다 들어갑니다."
  },
  {
    "start": 166.4,
    "end": 170.76000000000002,
    "text": ">> 여기가 지옥이 될 수도 있기 때문에"
  },
  {
    "start": 168.4,
    "end": 171.87900000000002,
    "text": "최대한 넘어옵니다. 이게 요리도"
  },
  {
    "start": 170.76,
    "end": 173.35999999999999,
    "text": "나가야 돼요."
  },
  {
    "start": 171.879,
    "end": 175.07999999999998,
    "text": ">> 일단 가두고"
  },
  {
    "start": 173.36,
    "end": 177.20000000000002,
    "text": ">> 란이 나갈 수 있어요. 마녀도 없는"
  },
  {
    "start": 175.08,
    "end": 178.76000000000002,
    "text": "요리기라 생각 못 나갈"
  },
  {
    "start": 177.2,
    "end": 180.95899999999997,
    "text": ">> 나머지가 도망가야 돼요"
  },
  {
    "start": 178.76,
    "end": 183.28,
    "text": ">> 페이가 혼자 페이 때려요 페이"
  },
  {
    "start": 180.959,
    "end": 185.12,
    "text": "때리는데 못 때려요네"
  },
  {
    "start": 183.28,
    "end": 187.4,
    "text": ">> 잡아버립니다. 겐지"
  },
  {
    "start": 185.12,
    "end": 188.72,
    "text": ">> 여기가 순간적으로 전멸을 당하면서"
  },
  {
    "start": 187.4,
    "end": 190.0,
    "text": "지옥으로 바뀌었죠"
  },
  {
    "start": 188.72,
    "end": 191.64,
    "text": ">> 네"
  },
  {
    "start": 190.0,
    "end": 193.64,
    "text": ">> 그 와중에 이즈리얼 한번 밀어내"
  },
  {
    "start": 191.64,
    "end": 194.95899999999997,
    "text": "보려고 하는 거 같은데 따라가나요"
  },
  {
    "start": 193.64,
    "end": 198.319,
    "text": ">> 정 한번 꽂잡봤는데"
  },
  {
    "start": 194.959,
    "end": 199.08,
    "text": ">> 연계 못 따라갈 만하지 않잖아가 정화"
  },
  {
    "start": 198.319,
    "end": 200.67999999999998,
    "text": "아직 안 돌아서"
  },
  {
    "start": 199.08,
    "end": 203.15900000000002,
    "text": ">> 뛰었어요 다시 한번 연결"
  },
  {
    "start": 200.68,
    "end": 204.56,
    "text": ">> 좌반했습니다. 이게 정확이 한 10초"
  },
  {
    "start": 203.159,
    "end": 206.79899999999998,
    "text": "정도 남은 걸로 보였거든요. 그"
  },
  {
    "start": 204.56,
    "end": 209.31900000000002,
    "text": "사이의 틈을 엄청 잘 찔렀어요. 물론"
  },
  {
    "start": 206.799,
    "end": 211.20000000000002,
    "text": "관문이 있어서 금방 오긴 합니다."
  },
  {
    "start": 209.319,
    "end": 213.35999999999999,
    "text": ">> 이게 워낙 금방 오기 때문에 사실상"
  },
  {
    "start": 211.2,
    "end": 214.95899999999997,
    "text": "한타 그림으로 갈 거 같아요."
  },
  {
    "start": 213.36,
    "end": 217.20000000000002,
    "text": ">> 운명을 한번 돌리면서 같이 합류를 해"
  },
  {
    "start": 214.959,
    "end": 218.68,
    "text": "봅니다. 전투를 펼치나요? 잘 먹고"
  },
  {
    "start": 217.2,
    "end": 219.76,
    "text": ">> 일단 길이 들어왔는데"
  },
  {
    "start": 218.68,
    "end": 220.64000000000001,
    "text": ">> 뭐 밀어냈고요."
  },
  {
    "start": 219.76,
    "end": 222.879,
    "text": ">> 그다음에 이퀄"
  },
  {
    "start": 220.64,
    "end": 225.48,
    "text": ">> 이퀄렸습니다. 일단 걸렸."
  },
  {
    "start": 222.879,
    "end": 228.28,
    "text": ">> 아 이거 이러면 어 그죠. 이게 보통"
  },
  {
    "start": 225.48,
    "end": 229.51899999999998,
    "text": "이퀄이 일단 한번 깔리고 나면 그다음"
  },
  {
    "start": 228.28,
    "end": 230.68,
    "text": "턴을 노려야 되기 때문에"
  },
  {
    "start": 229.519,
    "end": 232.159,
    "text": ">> 뒤로 살짝만 빠져 있습니다."
  },
  {
    "start": 230.68,
    "end": 233.76000000000002,
    "text": ">> 근데 이거 혹시 뭐 뒤까지 쪼이"
  },
  {
    "start": 232.159,
    "end": 234.48,
    "text": "하나요? 어 포탑을 끼고 버티고 있는"
  },
  {
    "start": 233.76,
    "end": 236.48,
    "text": "팀원인데"
  },
  {
    "start": 234.48,
    "end": 238.04,
    "text": ">> 사실네 명 정도고 포탑 체력도 뭐"
  },
  {
    "start": 236.48,
    "end": 239.35999999999999,
    "text": "아예 없는 건 아니니까"
  },
  {
    "start": 238.04,
    "end": 242.4,
    "text": ">> 어"
  },
  {
    "start": 239.36,
    "end": 245.15900000000002,
    "text": ">> 어어 체력 관리 해보나요 예 체력"
  },
  {
    "start": 242.4,
    "end": 247.12,
    "text": "관리 일단는 멤버들 있죠"
  },
  {
    "start": 245.159,
    "end": 248.0,
    "text": ">> 나머지 봐야 돼요 이게 딱 이렇게"
  },
  {
    "start": 247.12,
    "end": 248.519,
    "text": "되면 예"
  },
  {
    "start": 248.0,
    "end": 252.04,
    "text": ">> 페이가"
  },
  {
    "start": 248.519,
    "end": 252.64000000000001,
    "text": ">> 그래도 데려가면서 데려가면서 카페이트"
  },
  {
    "start": 252.04,
    "end": 254.72,
    "text": "카이"
  },
  {
    "start": 252.64,
    "end": 256.68,
    "text": ">> 이렇게 [비명]"
  },
  {
    "start": 254.72,
    "end": 259.12,
    "text": ">> 젠지"
  },
  {
    "start": 256.68,
    "end": 261.44,
    "text": ">> 그니까 젠지가 상대 컨디션이 괜찮다고"
  },
  {
    "start": 259.12,
    "end": 263.6,
    "text": "하더라도 기본적으로 탑에 탑 정글"
  },
  {
    "start": 261.44,
    "end": 264.199,
    "text": "미대는 덩치 들이 있잖아요. 엄청"
  },
  {
    "start": 263.6,
    "end": 266.6,
    "text": "불편해요."
  },
  {
    "start": 264.199,
    "end": 269.24,
    "text": ">> 생이브 당할 거 같은데요."
  },
  {
    "start": 266.6,
    "end": 270.8,
    "text": ">> 전멸이 없어서 저항할 힘이 없습니다."
  },
  {
    "start": 269.24,
    "end": 272.8,
    "text": ">> 아, 그대로 끊었죠."
  },
  {
    "start": 270.8,
    "end": 275.039,
    "text": ">> 이미 한타구도가 무너져요. 어,"
  },
  {
    "start": 272.8,
    "end": 276.88,
    "text": "그리고 이런 위치를 다"
  },
  {
    "start": 275.039,
    "end": 278.24,
    "text": ">> 너무 아파요. 너무 아파요."
  },
  {
    "start": 276.88,
    "end": 281.28,
    "text": ">> 뒤로 이동하면서 한번 버텨줬는데"
  },
  {
    "start": 278.24,
    "end": 282.24,
    "text": "초비가 좀 남아 있습니다."
  },
  {
    "start": 281.28,
    "end": 286.08,
    "text": ">> 베비"
  },
  {
    "start": 282.24,
    "end": 289.8,
    "text": ">> 뭔가 맞바닥 어려운 상황인데"
  },
  {
    "start": 286.08,
    "end": 289.8,
    "text": ">> 바텀 살짝 써 볼게."
  },
  {
    "start": 290.68,
    "end": 295.0,
    "text": "은 하늘도 뚫어버릴 트린이다."
  },
  {
    "start": 293.4,
    "end": 295.52,
    "text": ">> 어 그 전가 펼칩니다. 캐년 한번"
  },
  {
    "start": 295.0,
    "end": 297.24,
    "text": "물었어요."
  },
  {
    "start": 295.52,
    "end": 298.24,
    "text": ">> 그리고 지금 럼블리 이퀄 없는 턴."
  },
  {
    "start": 297.24,
    "end": 301.16,
    "text": "어 그래서 더 찔립니다."
  },
  {
    "start": 298.24,
    "end": 303.24,
    "text": ">> 네. 좀 마무리까지만 어떻게 안 덮고"
  },
  {
    "start": 301.16,
    "end": 305.47900000000004,
    "text": "오히려"
  },
  {
    "start": 303.24,
    "end": 306.96000000000004,
    "text": ">> 신짜우가 못 버티고요. 그리고 길게"
  },
  {
    "start": 305.479,
    "end": 308.52,
    "text": "싸우다 보면 또 이에 돌아요."
  },
  {
    "start": 306.96,
    "end": 310.23999999999995,
    "text": ">> 자 그래서 위쪽으로 쫓아오는데 도망갈"
  },
  {
    "start": 308.52,
    "end": 312.08,
    "text": "수이 없는 상황이에요. 잘 빠져야 될"
  },
  {
    "start": 310.24,
    "end": 313.88,
    "text": "거 같습니다. 각자 생존하고 요리"
  },
  {
    "start": 312.08,
    "end": 316.12,
    "text": "그냥 돈을 벌자예요."
  },
  {
    "start": 313.88,
    "end": 319.52,
    "text": ">> 아게 넘어간는데 초비가 쫓아가는 그런"
  },
  {
    "start": 316.12,
    "end": 322.36,
    "text": "모습이었고 이콜은 여다가 갑니다."
  },
  {
    "start": 319.52,
    "end": 325.28,
    "text": ">> 아 결 이렇게"
  },
  {
    "start": 322.36,
    "end": 326.759,
    "text": ">> 바론까지 넘겨치고 있는 젠지."
  },
  {
    "start": 325.28,
    "end": 327.08,
    "text": "요리 엇박자로"
  },
  {
    "start": 326.759,
    "end": 328.56,
    "text": ">> 어"
  },
  {
    "start": 327.08,
    "end": 331.44,
    "text": ">> 너무 오네요."
  },
  {
    "start": 328.56,
    "end": 333.0,
    "text": ">> 그래도 상대가 이퀄리 빠졌으니까 한번"
  },
  {
    "start": 331.44,
    "end": 336.68,
    "text": "와보겠다인가요?"
  },
  {
    "start": 333.0,
    "end": 340.4,
    "text": "근데 이게 막상 와 나가기가 이게"
  },
  {
    "start": 336.68,
    "end": 342.40000000000003,
    "text": ">> 그리고 뒤에는 또 럼블리 러고"
  },
  {
    "start": 340.4,
    "end": 343.59999999999997,
    "text": ">> 어 비선이동으로 빠지고요."
  },
  {
    "start": 342.4,
    "end": 345.52,
    "text": ">> 페이커도 위험하고"
  },
  {
    "start": 343.6,
    "end": 348.40000000000003,
    "text": ">> 아 그래서 이게 갑자기 모였다가"
  },
  {
    "start": 345.52,
    "end": 350.44,
    "text": "추가타가 나오나요? 그래서 도란도"
  },
  {
    "start": 348.4,
    "end": 352.75899999999996,
    "text": "위험합니다."
  },
  {
    "start": 350.44,
    "end": 355.88,
    "text": ">> 최대한 미니엠버 이스탄의 격돌"
  },
  {
    "start": 352.759,
    "end": 358.16,
    "text": ">> 하지만 이렇게 결국 돌란까지"
  },
  {
    "start": 355.88,
    "end": 359.68,
    "text": ">> 끊미라 젠지"
  },
  {
    "start": 358.16,
    "end": 361.44,
    "text": ">> 사이저 뭐 이지열의 포킹 이런 거"
  },
  {
    "start": 359.68,
    "end": 363.529,
    "text": "생각해 보면 끔찍하잖아요."
  },
  {
    "start": 361.44,
    "end": 364.88,
    "text": ">> 그래서"
  },
  {
    "start": 363.529,
    "end": 368.039,
    "text": "[비명]"
  },
  {
    "start": 364.88,
    "end": 370.56,
    "text": ">> 안 와 이게가"
  },
  {
    "start": 368.039,
    "end": 372.31899999999996,
    "text": "아니 스키 말도 안 되는"
  },
  {
    "start": 370.56,
    "end": 374.12,
    "text": ">> 콤비네이션을 만들어는 체인지가 그대로"
  },
  {
    "start": 372.319,
    "end": 376.91900000000004,
    "text": "뚫어버립니다. 페이즈가 유일한"
  },
  {
    "start": 374.12,
    "end": 378.199,
    "text": "희망인데이 순간 이거 막기도 힘들죠."
  },
  {
    "start": 376.919,
    "end": 379.68,
    "text": "자 위쪽으로 올라갑니다. 이제 경기를"
  },
  {
    "start": 378.199,
    "end": 380.36,
    "text": "끝내기 위해서 푹신하고 있는"
  },
  {
    "start": 379.68,
    "end": 383.16,
    "text": "제지입니다."
  },
  {
    "start": 380.36,
    "end": 386.319,
    "text": ">> 아니 무슨 매드무비 같은데 나올 법한"
  },
  {
    "start": 383.16,
    "end": 387.96000000000004,
    "text": "연계를 해서 한 방에 그냥 뚫고 용의"
  },
  {
    "start": 386.319,
    "end": 388.72,
    "text": "영혼도 필요 없다는 식으로 게임"
  },
  {
    "start": 387.96,
    "end": 390.23999999999995,
    "text": "끝내는데요."
  },
  {
    "start": 388.72,
    "end": 392.319,
    "text": ">> 저항을 할 수 없는 팀원이 됐습니다."
  },
  {
    "start": 390.24,
    "end": 396.44,
    "text": "초비가 멈춰 있는 가운데 넥서스가"
  },
  {
    "start": 392.319,
    "end": 396.44,
    "text": "이렇게 파괴됩니다."
  },
  {
    "start": 397.08,
    "end": 401.12,
    "text": "룰러의 딜량 그리고 초비의 럼블의"
  },
  {
    "start": 399.639,
    "end": 403.40000000000003,
    "text": "활용 그리고 기인의 다재단능한"
  },
  {
    "start": 401.12,
    "end": 405.52,
    "text": "레넥톤의 움직임 캐년과 규의"
  },
  {
    "start": 403.4,
    "end": 407.28,
    "text": "합작품까지 포함을 한다면 27분"
  },
  {
    "start": 405.52,
    "end": 409.039,
    "text": "경기뭐 젠지만을 위한 그런 경기처럼"
  },
  {
    "start": 407.28,
    "end": 411.88,
    "text": "느껴졌습니다."
  },
  {
    "start": 409.039,
    "end": 412.31899999999996,
    "text": ">> 이거 못 잡나? 나이스"
  },
  {
    "start": 411.88,
    "end": 414.36,
    "text": "8초"
  },
  {
    "start": 412.319,
    "end": 415.52000000000004,
    "text": ">> 이번턴에 나 여기 시야 세 먹을게"
  },
  {
    "start": 414.36,
    "end": 417.599,
    "text": ">> 나이스"
  },
  {
    "start": 415.52,
    "end": 418.24,
    "text": ">> 괜찮아 야 작 나왔고 한번 깔아봄"
  },
  {
    "start": 417.599,
    "end": 421.12,
    "text": ">> 아"
  },
  {
    "start": 418.24,
    "end": 423.40000000000003,
    "text": ">> 나 한번 봐줘 봐져 봐져"
  },
  {
    "start": 421.12,
    "end": 424.039,
    "text": ">> 생겼어야 트펜까지"
  },
  {
    "start": 423.4,
    "end": 425.0,
    "text": ">> 아 트페"
  },
  {
    "start": 424.039,
    "end": 426.639,
    "text": ">> 트페 트페플"
  },
  {
    "start": 425.0,
    "end": 427.879,
    "text": ">> 빠르다 없어 끝낼만한데"
  },
  {
    "start": 426.639,
    "end": 428.72,
    "text": ">> 어 끝낼만해 어 그냥 여기서 게임"
  },
  {
    "start": 427.879,
    "end": 429.28000000000003,
    "text": "끝내도 될"
  },
  {
    "start": 428.72,
    "end": 430.8,
    "text": ">> 나 마나 없어"
  },
  {
    "start": 429.28,
    "end": 432.28,
    "text": ">> 나 미칼일 돼"
  },
  {
    "start": 430.8,
    "end": 434.08,
    "text": ">> 야 타워치다가 들어놓다 일때"
  },
  {
    "start": 432.28,
    "end": 435.75899999999996,
    "text": ">> 여기 클린즈 먼저 써 줘요 그냥"
  },
  {
    "start": 434.08,
    "end": 437.4,
    "text": ">> 내가 먼저 요리 때려줄게 앞으로 나와"
  },
  {
    "start": 435.759,
    "end": 438.039,
    "text": ">> 얘네 여기 단어플이야 단노플"
  },
  {
    "start": 437.4,
    "end": 438.75899999999996,
    "text": ">> 한번 빼면서"
  },
  {
    "start": 438.039,
    "end": 440.0,
    "text": ">> 어"
  },
  {
    "start": 438.759,
    "end": 442.08000000000004,
    "text": ">> 단어플 단어노플"
  },
  {
    "start": 440.0,
    "end": 445.759,
    "text": "어"
  },
  {
    "start": 442.08,
    "end": 445.75899999999996,
    "text": "끝내자. 아, 끝났는데."
  }
]