  {
    "start": 327.56,
    "end": 331.919,
    "text": "거예요. 뭐"
  },
  {
    "start": 328.88,
    "end": 333.28,
    "text": ">> 이것도 그냥 버티면 나가 나가야"
  },
  {
    "start": 331.919,
    "end": 334.15999999999997,
    "text": "돼요. 또"
