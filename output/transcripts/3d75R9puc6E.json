  {
    "start": 272.639,
    "end": 275.36,
    "text": "더 들어왔죠. 눌러서"
  },
  {
    "start": 273.6,
    "end": 278.44,
    "text": ">> 상태도 무너지고요."
  },
  {
    "start": 275.36,
    "end": 279.8,
    "text": ">> 다 넘어갑니다. 캐리아가 룰러를 울고"
  },
  {
    "start": 278.44,
    "end": 280.16,
    "text": "있었고요."
  },
  {
    "start": 279.8,
    "end": 281.84000000000003,
    "text": ">> 이것도"
  },
  {
    "start": 280.16,
    "end": 283.72,
    "text": ">> 그리고 오너가 좋차"
